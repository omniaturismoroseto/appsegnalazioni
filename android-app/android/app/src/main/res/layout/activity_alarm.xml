<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#B91C1C">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨"
        android:textSize="72sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMERGENZA"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/alarmSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Allarme immediato dalla postazione"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:alpha="0.9"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnOpenApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:padding="16dp"
        android:text="Apri l'app"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#B91C1C"
        android:backgroundTint="#FFFFFF" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Ferma allarme"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7F1D1D" />

</LinearLayout>
